JWT_SECRET=change_this_to_a_long_random_secret_string
# 32-byte AES-256 key as 64 hex chars: openssl rand -hex 32
ENCRYPTION_KEY=change_this_to_a_random_64_char_hex_string
POSTGRES_USER=dockyard
POSTGRES_PASSWORD=dockyard
POSTGRES_DB=dockyard

# Run GORM AutoMigrate on startup (true for dev convenience).
# Set to false in production — the SQL files in database/init/ are the source of truth.
# AUTO_MIGRATE=false

# --- Rootless Docker only (leave commented for a standard Docker install) ---
# Path to the rootless daemon socket (use your own uid: id -u):
# DOCKER_SOCK=/run/user/1000/docker.sock
# In-container group id that the socket maps to; check with:
#   docker-compose exec backend ls -ln /var/run/docker.sock
# DOCKER_GID=135

