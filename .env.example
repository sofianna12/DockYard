JWT_SECRET=change_this_to_a_long_random_secret_string
# 32-byte AES-256 key as 64 hex chars: openssl rand -hex 32
ENCRYPTION_KEY=change_this_to_a_random_64_char_hex_string
# Absolute host path where uploaded project files are stored (must match ./data/projects on the host)
FILES_HOST_DIR=/home/pc/DockYard/data/projects
POSTGRES_USER=dockyard
POSTGRES_PASSWORD=dockyard
POSTGRES_DB=dockyard
